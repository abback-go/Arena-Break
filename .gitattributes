# ==========================================================
#  ARENA BREAK — .gitattributes
# ==========================================================

# 줄바꿈 자동 정규화 (Windows/macOS 혼용 팀에서 필수)
* text=auto

# Unity YAML 파일 — 텍스트로 취급하고 SmartMerge 사용
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.compute   text
*.json      text
*.md        text
*.txt       text
*.asmdef    text
*.asmref    text

*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.physicMaterial text merge=unityyamlmerge eol=lf
*.meta      text merge=unityyamlmerge eol=lf

# 스크립트 파일 실행 권한
tools/*.sh  text eol=lf

# ----------------------------------------------------------
# Git LFS — 이 프로젝트는 사용하지 않습니다
#
# LFS 규칙을 켜두면 세 가지 문제가 생깁니다.
#   1) LFS가 포함된 리포는 GitHub Template repository 로 지정할 수 없습니다.
#   2) git-lfs 가 없는 PC에서 clone하면 이미지가 포인터 텍스트로 내려와
#      Unity 임포트가 깨집니다.
#   3) GitHub 무료 계정의 LFS 대역폭은 월 1GB입니다.
#
# 나중에 대용량 에셋이 필요해지면 그때 아래 주석을 풀고
# 교수·학생 전원이 `git lfs install` 을 실행한 뒤 사용하세요.
#
# *.png  filter=lfs diff=lfs merge=lfs -text
# *.jpg  filter=lfs diff=lfs merge=lfs -text
# *.fbx  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text
# *.mp3  filter=lfs diff=lfs merge=lfs -text
# *.ogg  filter=lfs diff=lfs merge=lfs -text
# *.ttf  filter=lfs diff=lfs merge=lfs -text

# 바이너리로 취급 (diff 시도하지 않음)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.tga   binary
*.psd   binary
*.fbx   binary
*.obj   binary
*.blend binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
